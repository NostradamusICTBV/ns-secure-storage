{
	"name": "@nostradamus/ns-secure-storage",
	"version": "1.0.1",
	"description": "NativeScript secure storage for the Nostradamus apps: Android Keystore-backed EncryptedSharedPreferences and iOS Keychain. Fork of @nativescript/secure-storage.",
	"main": "dist/index",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"fs.cpSync('src/index.d.ts', 'dist/index.d.ts'); fs.cpSync('src/@types', 'dist/@types', { recursive: true })\"",
		"code:format": "prettier --write .",
		"code:format:check": "prettier --check .",
		"test:unit": "istanbun --isolate",
		"prepack": "npm run build"
	},
	"nativescript": {
		"platforms": {
			"android": "7.0.0",
			"ios": "7.0.0"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NostradamusICTBV/ns-secure-storage.git"
	},
	"homepage": "https://github.com/NostradamusICTBV/ns-secure-storage",
	"bugs": {
		"url": "https://github.com/NostradamusICTBV/ns-secure-storage/issues"
	},
	"keywords": [
		"NativeScript",
		"TypeScript",
		"iOS",
		"Android",
		"Keychain",
		"Keystore",
		"EncryptedSharedPreferences"
	],
	"author": {
		"name": "Nostradamus ICT BV"
	},
	"license": "Apache-2.0",
	"peerDependencies": {
		"@nativescript/core": "^9.0.0"
	},
	"devDependencies": {
		"@jeroenzwart/istanbun": "^1.0.3",
		"@nativescript/core": "^9.1.0",
		"@nativescript/types": "~9.1.0",
		"@nativescript/types-ios": "~9.1.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	},
	"files": [
		"dist",
		"platforms",
		"CHANGELOG.md",
		"MIGRATION.md"
	]
}
