{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": false,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "dom"],
		"types": ["@nativescript/types", "@nativescript/types-ios/complete"],
		"rootDir": ".",
		"outDir": "."
	},
	"files": ["common.ts", "index.android.ts", "index.ios.ts"],
	"include": ["@types/**/*.d.ts"]
}
