{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": false,
		"declaration": true,
		"sourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "dom"],
		"types": ["@nativescript/types", "@nativescript/types-ios/complete"],
		"rootDir": "src",
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
